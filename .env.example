# Copy to .env and fill in. See .claude/architecture.md and .claude/future-services.md.

# --- Database (packages/database) ---
# Local: matches docker-compose.yml. Production: Neon or Vercel Postgres connection string.
DATABASE_URL="postgresql://azhl:azhl_dev@localhost:5432/azhl"

# --- apps/web ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth.js (scaffolded, real in Phase 4) ---
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Cloudinary (prepared, not provisioned — see .claude/future-services.md) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Vercel (prepared, not provisioned) ---
# Populated automatically by Vercel's own environment when deployed; no local value needed.
