# Template only — this file is not loaded automatically by any tool.
#
# Node/Next.js/Prisma each load .env from their OWN directory, not the monorepo root, so the
# real local env files live at:
#   apps/web/.env             (Next.js auto-loads this)
#   packages/database/.env    (Prisma CLI auto-loads this — only needs DATABASE_URL)
#
# Copy the relevant lines below into each of those files. See .claude/architecture.md and
# .claude/future-services.md.

# --- Database (packages/database, apps/web) ---
# Local: matches docker-compose.yml (host port 5433). Production: Neon or Vercel Postgres
# connection string — on Vercel it must also be set for the Build environment, since pages with
# `revalidate` are prerendered at build time and query the database.
DATABASE_URL="postgresql://azhl:azhl_dev@localhost:5433/azhl"

# --- apps/web ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth.js (scaffolded, real in Phase 4) ---
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Cloudinary (prepared, not provisioned — see .claude/future-services.md) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Vercel (prepared, not provisioned) ---
# Populated automatically by Vercel's own environment when deployed; no local value needed.
