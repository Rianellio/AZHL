{
  "name": "azhl",
  "private": true,
  "version": "0.0.0",
  "description": "AZHL — a premium hockey league platform.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\" --ignore-path .gitignore",
    "db:migrate": "pnpm --filter @azhl/database run prisma:migrate",
    "db:seed": "pnpm --filter @azhl/database run prisma:seed",
    "db:studio": "pnpm --filter @azhl/database run prisma:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
